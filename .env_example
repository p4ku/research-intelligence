# ==============================================================================
# Platform Branding & System Naming
# Customize the system name across Web UI, FastMCP, Emails, and Django Admin.
# Examples:
#   APP_NAME="Systematic Literature Review"
#   APP_NAME="Intelligence Systematic Literature Review"
# ==============================================================================
APP_NAME=Schwarz Research Intelligence
APP_SHORT_NAME=SRI
APP_DESCRIPTION=Enterprise Systematic Literature Review (SLR), Deep-Tech Scouting, and Multimodal Extraction Platform.
NEXT_PUBLIC_APP_NAME=Schwarz Research Intelligence
NEXT_PUBLIC_APP_SHORT_NAME=SRI

# Core Django Settings
DEBUG=True
SECRET_KEY=your_django_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL with pgvector)
DB_HOST=localhost
DB_NAME=research_intelligence
DB_USER=postgres
DB_PASSWORD=development_password
DB_PORT=5432

# Task Broker & Cache
REDIS_URL=redis://localhost:6379/0

# Object Storage Configuration (AWS S3 or Local MinIO)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_dev_user
MINIO_SECRET_KEY=minio_dev_password
MINIO_SECURE=False

# API Keys
LENS_API_KEY=your_lens_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
SERPAPI_USE_SDK=True
GOOGLE_AGENT_API_KEY=mock-agent-key

# Mailgun Email Configuration
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_API_URL=https://api.eu.mailgun.net/v3
MAILGUN_SENDER_DOMAIN=soinventive.co.uk
DEFAULT_FROM_EMAIL=no-reply@soinventive.co.uk

# Google Cloud / Vertex AI Service Account Credentials
# Paste the single-line JSON representation of your Google service account credentials here.
# Note: escape any newlines in the private key with \n.
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "sit-disruption-t-wkzt-run-4sbq", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBg...---END PRIVATE KEY-----\n", "client_email": "oxford-piotr@sit-disruption-t-wkzt-run-4sbq.iam.gserviceaccount.com"}

# Sentry Performance & Error Monitoring
SENTRY_DSN=https://155678a8610461ae7c7eecdfdd0583a4@o4511999152291840.ingest.de.sentry.io/4511999157010512

# Zombie Process Watchdog Timeouts (in minutes: 180m = 3h, 360m = 6h)
ZOMBIE_WATCHDOG_COMPONENT_TIMEOUT_MINUTES=180
ZOMBIE_WATCHDOG_PIPELINE_TIMEOUT_MINUTES=360
