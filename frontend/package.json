{
  "name": "research-scanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && bun run scripts/contract-spec.ts --check",
    "lint:file": "eslint",
    "lint:claude": "claude -p 'you are a linter. please look at the changes vs. main and report any issues related to typos, bugs, type safety, or security concerns.\n\nReport the filename and line number on one line, and a description of the issue on the second line. Do not return any other text. Use context7 and webfetch if you are unsure about the latest use of a particular package in your linting'",
    "typecheck": "tsc --noEmit",
    "typecheck:file": "tsc --noEmit --incremental",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "test": "bun test",
    "contract:spec": "bun run scripts/contract-spec.ts",
    "contract:check": "bun run scripts/contract-check.ts",
    "snapshot:pull": "bun run scripts/snapshot-pull.ts",
    "snapshot:serve": "bun run scripts/snapshot-serve.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.11",
    "lucide-react": "^0.564.0",
    "motion": "^12.34.5",
    "next": "^16.1.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.15",
    "@types/bun": "^1.4.0",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
