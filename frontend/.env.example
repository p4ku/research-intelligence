# Where the Next.js server reaches Django (no trailing slash). Locally this is
# `manage.py runserver` or the docker-compose `api` service; in production it
# is the shared Cloud Foundry hostname.
BACKEND_INTERNAL_URL=http://localhost:8000

# Public URL of this app, used for metadata/Open Graph.
SITE_URL=http://localhost:3000

# System Branding & Platform Naming (Overrides default 'Research Intelligence')
# Examples:
#   NEXT_PUBLIC_APP_NAME="Systematic Literature Review"
#   NEXT_PUBLIC_APP_NAME="Intelligence Systematic Literature Review"
NEXT_PUBLIC_APP_NAME=Schwarz Research Intelligence
NEXT_PUBLIC_APP_SHORT_NAME=SRI

# Set to "false" to allow the session cookies over plain http with NODE_ENV=production.

# ── BFF sources ──────────────────────────────────────────────────────────────
# Each resource is fed by one of: stub (fixtures) | composed (built from
# today's Django endpoints) | django (the requested contract endpoint).
# Defaults live in src/lib/bff/core/source.ts; override per resource here.
# BFF_SOURCE_PAPERS=composed
# BFF_SOURCE_WORKSPACES=django
# BFF_SOURCE_PIPELINE_RUNS=django
# BFF_SOURCE_CHAT=django
# BFF_SOURCE_BRIEFINGS=composed
# BFF_SOURCE_PREFERENCES=stub
# BFF_SOURCE_SCORING=composed
# BFF_SOURCE_STARS=django
# BFF_SOURCE_SEARCH=composed

# ── Corpus snapshot ──────────────────────────────────────────────────────────
# The per-user corpus (src/lib/bff/corpus/snapshot.ts) is walked newest-first
# in pages (500 for the raw lists, 200 for the Django scorecard) and keeps at
# most this many papers; past it the pages show the newest and say so.
# CORPUS_MAX_PAPERS=2000
# JSON retained across users, in MB, least recently used out first. Parsed
# objects weigh roughly twice this in the heap: keep it at or under 128 on the
# 1G instance (V8's old space is capped at 768M there, manifest.yml). Under
# the scorecard source one user's corpus is ~48 MB on the Sep 2026 data, so
# 128 holds two users at once.
# CORPUS_CACHE_MAX_MB=128
# How long a request that did not read the run ledger trusts a confirmed
# corpus version before probing again (Home, /runs and /briefing always probe).
# CORPUS_PROBE_COOLDOWN_MS=5000
