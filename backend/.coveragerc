[run]
parallel = True
concurrency =
    multiprocessing
source =
    research_intelligence
    mcp_server
    chat
omit =
    */tests/*
    */migrations/*
    */wsgi.py
    */asgi.py

[report]
show_missing = False
skip_empty = True
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
