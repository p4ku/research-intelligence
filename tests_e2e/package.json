{
  "name": "sri-frontend-e2e-tests",
  "version": "1.0.0",
  "description": "Next.js Frontend E2E Test Suite in TypeScript with Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:prod": "E2E_TARGET_ENV=prod playwright test",
    "test:staging": "E2E_TARGET_ENV=staging playwright test",
    "test:local": "E2E_TARGET_ENV=local playwright test"
  },
  "keywords": [
    "playwright",
    "e2e",
    "nextjs",
    "typescript",
    "testing"
  ],
  "author": "Schwarz Research Intelligence Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
