# ==============================================================================
# Local CI/CD Configuration (.env)
# Used by local_cici/run_ci.sh and local_cici/run_cd.sh
# ==============================================================================

# STACKIT Cloud Foundry Target
CF_API_URL="https://api.system.01.cf.eu01.stackit.cloud"
CF_USERNAME=""
CF_PASSWORD=""
CF_ORG="organization-sri-production"
CF_SPACE="sri-prod"

# STACKIT / Docker Container Registry
REGISTRY_HOST="registry.onstackit.cloud"
REGISTRY_USER=""
REGISTRY_PASSWORD=""

# Image Repository Names
BACKEND_IMAGE="registry.onstackit.cloud/sri-production/sri-backend:latest"
FRONTEND_IMAGE="registry.onstackit.cloud/sri-production/sri-frontend:latest"

# Cloud Foundry Manifest configuration
CF_MANIFEST="manifest.yml"
CF_VARS_FILE="vars.yml"

# Deployment Flags
SKIP_TESTS=false
SKIP_IMAGE_BUILD=false
DEPLOY_TARGET="cf" # "cf", "docker", or "dry-run"
